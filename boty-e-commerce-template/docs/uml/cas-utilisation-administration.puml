@startuml
title Diagramme de cas d'utilisation — Administration

' Le diagramme décrit les objectifs fonctionnels du Gestionnaire du site.
' Les associations acteur/cas d'utilisation sont représentées par des lignes
' pleines sans pointe, conformément à la notation UML.

left to right direction

skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 34
skinparam ranksep 70
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ArrowColor #5B514F
skinparam usecase {
  BackgroundColor #FFF9F5
  BorderColor #8A7770
  FontColor #332A28
}
skinparam rectangle {
  BorderColor #8A7770
  FontColor #332A28
}

actor "Gestionnaire\ndu site" as Gestionnaire

rectangle "Application e-commerce M comme Maman — Espace administration" {
  usecase "S'authentifier" as UA_Connexion
  usecase "Consulter le tableau\nde bord" as UA_Dashboard

  usecase "Consulter les produits" as UA_VoirProduits
  usecase "Ajouter un produit" as UA_AjouterProduit
  usecase "Modifier un produit" as UA_ModifierProduit
  usecase "Dupliquer un produit" as UA_DupliquerProduit
  usecase "Ajuster le stock\nd'un produit" as UA_Stock
  usecase "Publier ou archiver\nun produit" as UA_Visibilite
  usecase "Supprimer un produit" as UA_SupprimerProduit

  usecase "Créer ou modifier\nune catégorie" as UA_EnregistrerCategorie
  usecase "Supprimer une catégorie" as UA_SupprimerCategorie

  usecase "Créer ou modifier\nune promotion" as UA_EnregistrerPromotion
  usecase "Supprimer une promotion" as UA_SupprimerPromotion

  usecase "Consulter les commandes" as UA_Commandes
  usecase "Mettre à jour l'état\nd'une commande" as UA_StatutCommande
  usecase "Annuler une commande" as UA_AnnulerCommande

  usecase "Consulter les clientes\net leur historique" as UA_Clientes
  usecase "Analyser les ventes\net les performances" as UA_Statistiques

  usecase "Définir les tailles, coloris,\nmatières et photos" as UA_ConfigurationProduit
  usecase "Modifier le hero\nde la page d'accueil" as UA_Hero
  usecase "Configurer l'identité,\nla livraison et la vitrine" as UA_Reglages

  usecase "Inviter un membre\nde l'équipe" as UA_InviterMembre
  usecase "Attribuer un rôle" as UA_AttribuerRole
  usecase "Désactiver ou supprimer\nun membre" as UA_RetirerMembre

  ' Liens de mise en page uniquement : ils sont invisibles au rendu et ne
  ' constituent pas des relations UML entre les cas d'utilisation.
  UA_Connexion -[hidden]right-> UA_Dashboard
  UA_Dashboard -[hidden]right-> UA_VoirProduits
  UA_VoirProduits -[hidden]right-> UA_AjouterProduit
  UA_AjouterProduit -[hidden]right-> UA_ModifierProduit
  UA_ModifierProduit -[hidden]right-> UA_DupliquerProduit
  UA_DupliquerProduit -[hidden]right-> UA_Stock
  UA_Stock -[hidden]right-> UA_Visibilite
  UA_Visibilite -[hidden]right-> UA_SupprimerProduit
  UA_SupprimerProduit -[hidden]right-> UA_EnregistrerCategorie
  UA_EnregistrerCategorie -[hidden]right-> UA_SupprimerCategorie
  UA_SupprimerCategorie -[hidden]right-> UA_EnregistrerPromotion
  UA_EnregistrerPromotion -[hidden]right-> UA_SupprimerPromotion
  UA_SupprimerPromotion -[hidden]right-> UA_Commandes
  UA_Commandes -[hidden]right-> UA_StatutCommande
  UA_StatutCommande -[hidden]right-> UA_AnnulerCommande
  UA_AnnulerCommande -[hidden]right-> UA_Clientes
  UA_Clientes -[hidden]right-> UA_Statistiques
  UA_Statistiques -[hidden]right-> UA_ConfigurationProduit
  UA_ConfigurationProduit -[hidden]right-> UA_Hero
  UA_Hero -[hidden]right-> UA_Reglages
  UA_Reglages -[hidden]right-> UA_InviterMembre
  UA_InviterMembre -[hidden]right-> UA_AttribuerRole
  UA_AttribuerRole -[hidden]right-> UA_RetirerMembre
}

' Associations de communication du Gestionnaire du site.
Gestionnaire -- UA_Connexion
Gestionnaire -- UA_Dashboard
Gestionnaire -- UA_VoirProduits
Gestionnaire -- UA_AjouterProduit
Gestionnaire -- UA_ModifierProduit
Gestionnaire -- UA_DupliquerProduit
Gestionnaire -- UA_Stock
Gestionnaire -- UA_Visibilite
Gestionnaire -- UA_SupprimerProduit
Gestionnaire -- UA_EnregistrerCategorie
Gestionnaire -- UA_SupprimerCategorie
Gestionnaire -- UA_EnregistrerPromotion
Gestionnaire -- UA_SupprimerPromotion
Gestionnaire -- UA_Commandes
Gestionnaire -- UA_StatutCommande
Gestionnaire -- UA_AnnulerCommande
Gestionnaire -- UA_Clientes
Gestionnaire -- UA_Statistiques
Gestionnaire -- UA_ConfigurationProduit
Gestionnaire -- UA_Hero
Gestionnaire -- UA_Reglages
Gestionnaire -- UA_InviterMembre
Gestionnaire -- UA_AttribuerRole
Gestionnaire -- UA_RetirerMembre

@enduml
