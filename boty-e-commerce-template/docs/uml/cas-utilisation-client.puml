@startuml
title Diagramme de cas d'utilisation — Client

' Diagramme volontairement limite aux objectifs metier du Client.
' Les associations acteur/cas d'utilisation sont des lignes pleines sans
' fleche : c'est la notation UML d'une association de communication.

left to right direction

skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 34
skinparam ranksep 70
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ArrowColor #5B514F
skinparam usecase {
  BackgroundColor #FFF9F5
  BorderColor #8A7770
  FontColor #332A28
}
skinparam rectangle {
  BorderColor #8A7770
  FontColor #332A28
}

actor "Client" as Client

rectangle "Application e-commerce M comme Maman — Espace client" {
  usecase "Parcourir le catalogue" as UC_Catalogue
  usecase "Ajouter un produit\nau panier" as UC_AjouterPanier
  usecase "Consulter son panier" as UC_ConsulterPanier
  usecase "Modifier la quantité\nd'un produit" as UC_ModifierQuantite
  usecase "Retirer un produit\ndu panier" as UC_RetirerPanier

  usecase "Ajouter un produit\naux favoris" as UC_AjouterFavori
  usecase "Consulter ses favoris" as UC_ConsulterFavoris
  usecase "Retirer un produit\ndes favoris" as UC_RetirerFavori

  usecase "Créer un compte" as UC_Inscription
  usecase "S'authentifier" as UC_Connexion
  usecase "Modifier ses informations\npersonnelles" as UC_Profil

  usecase "Passer une commande" as UC_Commander
  usecase "Commander à nouveau" as UC_Recommander
  usecase "Consulter ses commandes" as UC_Commandes
  usecase "Suivre l'évolution\nd'une commande" as UC_Suivi
  usecase "Annuler une commande" as UC_Annuler

  usecase "Consulter les avis" as UC_VoirAvis
  usecase "Déposer un avis" as UC_Avis

  ' Liens invisibles : ils ne font pas partie du modèle UML.
  ' Ils imposent seulement un ordre vertical stable et lisible au rendu.
  UC_Catalogue -[hidden]right-> UC_AjouterPanier
  UC_AjouterPanier -[hidden]right-> UC_ConsulterPanier
  UC_ConsulterPanier -[hidden]right-> UC_ModifierQuantite
  UC_ModifierQuantite -[hidden]right-> UC_RetirerPanier
  UC_RetirerPanier -[hidden]right-> UC_AjouterFavori
  UC_AjouterFavori -[hidden]right-> UC_ConsulterFavoris
  UC_ConsulterFavoris -[hidden]right-> UC_RetirerFavori
  UC_RetirerFavori -[hidden]right-> UC_VoirAvis
  UC_VoirAvis -[hidden]right-> UC_Avis
  UC_Avis -[hidden]right-> UC_Inscription
  UC_Inscription -[hidden]right-> UC_Connexion
  UC_Connexion -[hidden]right-> UC_Profil
  UC_Profil -[hidden]right-> UC_Commander
  UC_Commander -[hidden]right-> UC_Commandes
  UC_Commandes -[hidden]right-> UC_Suivi
  UC_Suivi -[hidden]right-> UC_Annuler
  UC_Annuler -[hidden]-> UC_Recommander
}

' Associations de communication Client / fonctionnalités.
Client -- UC_Catalogue
Client -- UC_AjouterPanier
Client -- UC_ConsulterPanier
Client -- UC_ModifierQuantite
Client -- UC_RetirerPanier
Client -- UC_AjouterFavori
Client -- UC_ConsulterFavoris
Client -- UC_RetirerFavori
Client -- UC_Inscription
Client -- UC_Connexion
Client -- UC_Profil
Client -- UC_Commander
Client -- UC_Commandes
Client -- UC_Suivi
Client -- UC_Annuler
Client -- UC_VoirAvis
Client -- UC_Avis

' Relation d'extension demandée entre les deux cas indiqués.
UC_Annuler .right.> UC_Recommander : <<extend>>

@enduml
