@startuml
title Diagramme de cas d'utilisation — M comme Maman

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Client" as Client
actor "Gestionnaire\ndu site" as Gestionnaire

rectangle "Application e-commerce M comme Maman" {

  package "Espace client" {
    usecase "Parcourir le catalogue" as UC_Catalogue
    usecase "Rechercher et filtrer\nles produits" as UC_Recherche
    usecase "Consulter une fiche produit" as UC_Fiche
    usecase "Consulter le guide\ndes tailles" as UC_Guide
    usecase "Gérer le panier" as UC_Panier
    usecase "Gérer les favoris" as UC_Favoris

    usecase "Créer un compte" as UC_Inscription
    usecase "S'authentifier" as UC_Connexion
    usecase "Gérer son profil" as UC_Profil
    usecase "Gérer ses adresses et\npréférences de tailles" as UC_Preferences

    usecase "Passer une commande" as UC_Commander
    usecase "Saisir ses coordonnées" as UC_Coordonnees
    usecase "Choisir le mode\nde livraison" as UC_Livraison
    usecase "Choisir le mode\nde paiement" as UC_Paiement

    usecase "Consulter ses commandes" as UC_Commandes
    usecase "Suivre l'évolution\nd'une commande" as UC_Suivi
    usecase "Annuler une commande" as UC_Annuler
    usecase "Commander à nouveau" as UC_Recommander

    usecase "Consulter les avis" as UC_VoirAvis
    usecase "Déposer un avis" as UC_Avis
    usecase "S'inscrire à la newsletter" as UC_Newsletter
  }

  package "Espace administration" {
    usecase "S'authentifier à\nl'administration" as UA_Connexion
    usecase "Consulter le tableau\nde bord" as UA_Dashboard

    usecase "Gérer le catalogue" as UA_Catalogue
    usecase "Gérer les produits" as UA_Produits
    usecase "Gérer le stock et\nla visibilité" as UA_Stock
    usecase "Gérer les catégories" as UA_Categories
    usecase "Configurer tailles, coloris,\nmatières et médias" as UA_Configuration

    usecase "Gérer les promotions" as UA_Promotions
    usecase "Gérer le bandeau\nde la page d'accueil" as UA_Hero

    usecase "Gérer les commandes" as UA_Commandes
    usecase "Rechercher et consulter\nune commande" as UA_VoirCommande
    usecase "Mettre à jour l'état\nd'une commande" as UA_Statut
    usecase "Annuler une commande" as UA_Annuler

    usecase "Consulter les clientes\net leur historique" as UA_Clients
    usecase "Consulter les statistiques" as UA_Statistiques
    usecase "Gérer l'équipe et\nles rôles" as UA_Equipe
    usecase "Configurer la boutique" as UA_Reglages
    usecase "Configurer l'identité,\nla livraison et la vitrine" as UA_Options
  }
}

' Associations du Client
Client --> UC_Catalogue
Client --> UC_Panier
Client --> UC_Favoris
Client --> UC_Inscription
Client --> UC_Connexion
Client --> UC_Profil
Client --> UC_Commander
Client --> UC_Commandes
Client --> UC_VoirAvis
Client --> UC_Avis
Client --> UC_Newsletter

' Relations entre cas d'utilisation Client
UC_Recherche ..> UC_Catalogue : <<extend>>
UC_Fiche ..> UC_Catalogue : <<extend>>
UC_Guide ..> UC_Fiche : <<extend>>

UC_Profil ..> UC_Connexion : <<include>>
UC_Profil ..> UC_Preferences : <<include>>

UC_Commander ..> UC_Coordonnees : <<include>>
UC_Commander ..> UC_Livraison : <<include>>
UC_Commander ..> UC_Paiement : <<include>>
UC_Connexion ..> UC_Commander : <<extend>>

UC_Suivi ..> UC_Commandes : <<extend>>
UC_Annuler ..> UC_Suivi : <<extend>>
UC_Recommander ..> UC_Suivi : <<extend>>
UC_Avis ..> UC_Connexion : <<include>>

' Associations du Gestionnaire
Gestionnaire --> UA_Connexion
Gestionnaire --> UA_Dashboard
Gestionnaire --> UA_Catalogue
Gestionnaire --> UA_Promotions
Gestionnaire --> UA_Hero
Gestionnaire --> UA_Commandes
Gestionnaire --> UA_Clients
Gestionnaire --> UA_Statistiques
Gestionnaire --> UA_Equipe
Gestionnaire --> UA_Reglages

' Relations entre cas d'utilisation Administration
UA_Catalogue ..> UA_Produits : <<include>>
UA_Catalogue ..> UA_Categories : <<include>>
UA_Catalogue ..> UA_Configuration : <<include>>
UA_Produits ..> UA_Stock : <<include>>

UA_Commandes ..> UA_VoirCommande : <<include>>
UA_Commandes ..> UA_Statut : <<include>>
UA_Annuler ..> UA_Commandes : <<extend>>

UA_Reglages ..> UA_Options : <<include>>

note right of UA_Statut
  Chaque changement d'état alimente
  le suivi consulté par le Client.
end note

note right of UA_Connexion
  Une session d'administration active est
  une précondition aux fonctions de gestion.
end note

@enduml
